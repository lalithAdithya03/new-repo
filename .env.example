# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. Never put the service-role key or AI keys in VITE_* variables:
# anything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Name of the Supabase Edge Function that generates AI tutor answers (see supabase/functions/tutor).
# Leave as-is unless you rename the function. Without it deployed, the tutor runs in demo (extractive) mode.
VITE_TUTOR_FUNCTION=tutor

# ---- Server-side only (set with `supabase secrets set`, NOT in this file) ----
# ANTHROPIC_API_KEY=...
# TUTOR_MODEL=claude-opus-5-5   (optional; this is the default)
